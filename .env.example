# Copy to .env.local and fill in. Never commit .env.local.

# MongoDB connection string (local: mongodb://127.0.0.1:27017/gylt, or a MongoDB Atlas URI)
MONGODB_URI=mongodb://127.0.0.1:27017/gylt

# NextAuth: generate a secret with `openssl rand -base64 32`
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# Optional OAuth sign-in. Each provider only appears when both values are set.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_ID=
GITHUB_SECRET=
FACEBOOK_ID=
FACEBOOK_SECRET=
